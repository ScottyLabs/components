{
    "name": "@scottylabs/types",
    "version": "0.0.0",
    "description": "Shared TypeScript prop types for ScottyLabs components. Both framework packages import from here so React and Svelte public APIs stay in sync.",
    "license": "(MIT OR Apache-2.0)",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "tsdown": "^0.5.0",
        "typescript": "^5.6.3"
    }
}
