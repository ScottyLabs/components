{
    "name": "@scottylabs/variants",
    "version": "0.0.0",
    "description": "tailwind-variants configurations shared across framework packages. Maps component prop combinations to sl- class names.",
    "license": "(MIT OR Apache-2.0)",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "dev": "tsdown --watch"
    },
    "dependencies": {
        "tailwind-variants": "^1.0.0"
    },
    "devDependencies": {
        "tsdown": "^0.5.0",
        "typescript": "^5.6.3"
    },
    "peerDependencies": {
        "@scottylabs/types": "workspace:*"
    }
}
