{
    "name": "@scottylabs/svelte",
    "version": "0.0.0",
    "description": "Svelte components for the ScottyLabs design system. Built on Bits UI primitives.",
    "license": "(MIT OR Apache-2.0)",
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "svelte": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "import": "./dist/index.js"
        }
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "svelte": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "svelte-package",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "dev": "svelte-package --watch"
    },
    "dependencies": {
        "@scottylabs/types": "workspace:*",
        "@scottylabs/variants": "workspace:*"
    },
    "devDependencies": {
        "@sveltejs/package": "^2.3.0",
        "bits-ui": "^2.0.0",
        "svelte": "^5.0.0",
        "svelte-check": "^4.0.0",
        "typescript": "^5.6.3"
    },
    "peerDependencies": {
        "@scottylabs/styles": "workspace:*",
        "@scottylabs/tokens": "workspace:*",
        "bits-ui": "^2.0.0",
        "svelte": "^5.0.0"
    }
}
