---
import colors from "@scottylabs/tokens/dtcg/colors";

type ColorValue = {
    colorSpace: string;
    components: [number, number, number];
    alpha?: number;
};

function toHex(value: ColorValue): string {
    const [r, g, b] = value.components;
    const alpha = value.alpha ?? 1;
    const to2 = (n: number) => Math.round(n * 255).toString(16).padStart(2, "0");
    const hex = `#${to2(r)}${to2(g)}${to2(b)}`;
    return alpha < 1 ? `${hex}${to2(alpha)}` : hex;
}

const primitives = (colors as any).primitives as Record<
    string,
    Record<string, { $value: ColorValue }>
>;

const ramps = Object.entries(primitives).map(([rampName, tokens]) => ({
    name: rampName,
    steps: Object.entries(tokens).map(([stepName, token]) => ({
        step: stepName,
        cssVar: `--sl-primitives-${rampName}-${stepName}`,
        hex: toHex(token.$value),
    })),
}));
---

<div class="primitives">
    {
        ramps.map((ramp) => (
            <section class="ramp">
                <h3>{ramp.name}</h3>
                <div class="swatches">
                    {ramp.steps.map((s) => (
                        <div class="swatch">
                            <div
                                class="color"
                                style={`background: var(${s.cssVar})`}
                            />
                            <span class="name">{`${ramp.name}.${s.step}`}</span>
                            <span class="hex">{s.hex}</span>
                        </div>
                    ))}
                </div>
            </section>
        ))
    }
</div>

<style>
    .primitives,
    .primitives * {
        margin: 0;
    }
    .primitives {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .ramp h3 {
        margin: 0 0 0.5rem 0;
        text-transform: capitalize;
    }
    .swatches {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
        align-items: start;
        gap: 0.75rem;
    }
    .swatch {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .color {
        height: 3rem;
        border-radius: 0.25rem;
        border: 1px solid rgba(127, 127, 127, 0.2);
    }
    .name,
    .hex {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.75rem;
        line-height: 1.4;
    }
    .hex {
        font-size: 0.7rem;
        opacity: 0.7;
    }
</style>
