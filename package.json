{
    "name": "@scottylabs/components",
    "private": true,
    "description": "Design tokens, React components, and Svelte components for ScottyLabs, generated from a shared Figma source.",
    "license": "(MIT OR Apache-2.0)",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "postinstall": "bun2nix -o bun.nix",
        "build": "bun run --filter './packages/*' build",
        "dev": "bun run --filter './apps/*' dev",
        "typecheck": "bun run --filter '*' typecheck",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "bun run build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.10",
        "typescript": "^5.6.3"
    },
    "packageManager": "bun@1.3.5"
}
